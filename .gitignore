# secrets
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/

# node
node_modules/
dist/

# runtime state written by the router
state/
.task_scratch/

# os
.DS_Store

# generated by tools/bootstrap.sh from hardware_compute ARTIFACT A — never edit in place
tools/hw/verify_compute.sh

# ── Obsidian, inside vault/ ──────────────────────────────────────────────────
# vault/ is opened directly as an Obsidian vault, so Obsidian writes its own
# state in here. Plugin data.json is where API keys land — Copilot, Text
# Generator, remotely-save (S3/WebDAV creds), anything talking to a paid service.
# Ignored by default; force-add a specific one you actually want versioned.
vault/.obsidian/plugins/*/data.json
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/cache
vault/.obsidian/graph.json
vault/.trash/

# Local embedding caches — a vectorized copy of the whole corpus, rebuildable.
# state/ already covers state/rag_index/ and state/rag_traces/; these catch the
# copies Obsidian-side plugins write next to the notes.
vault/.smart-env/
vault/.smart-connections/
*.faiss
*.embeddings.json

# ── Additional secrets ───────────────────────────────────────────────────────
# D5 records a third-party key reaching this repo once already. These are the
# shapes it would take next.
*.key
*.pem
*.p12
*.pfx
secrets/
credentials.json
*.token
.netrc
tools/**/config.local.*

# ── OS / editor ──────────────────────────────────────────────────────────────
._*
Thumbs.db
desktop.ini
*~
*.swp
.idea/
.vscode/
